#!/usr/bin/env bash
# chore: release X.Y.Z must name the manifest version.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
msg_file="$1"
first="$(head -n 1 "${msg_file}")"
case "${first}" in
  "chore: release "*)
    named="${first#chore: release }"
    named="${named%% *}"
    home="$(python3 -c 'import json, pathlib; print(json.loads(pathlib.Path(".grok-plugin/plugin.json").read_text())["version"])')"
    if [ "${named}" != "${home}" ]; then
      echo "check-version: commit says release ${named}; manifest is ${home}" >&2
      exit 1
    fi
    python3 "${root}/scripts/check-version" --release
    ;;
esac
exit 0
